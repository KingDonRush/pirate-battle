{
  "name": "pirate-battle",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0 <23"
  },
  "packageManager": "npm@10.9.4",
  "scripts": {
    "dev": "vite",
    "build": "npm run typecheck && vite build",
    "preview": "vite preview",
    "lint": "eslint . --max-warnings 0",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test:e2e": "playwright test",
    "test:e2e:dev": "E2E_SERVER=dev playwright test",
    "test:e2e:report": "playwright show-report artifacts/playwright/report",
    "browser:install": "PLAYWRIGHT_SKIP_BROWSER_GC=1 playwright install chromium firefox",
    "check": "npm run check:structure && npm run lint && npm run typecheck && npm run format:check && npm run build && npm run test:e2e",
    "check:structure": "node --test scripts/check-structure.test.mjs && node scripts/check-structure.mjs",
    "profile": "playwright test --config playwright.profile.config.ts"
  },
  "dependencies": {
    "@tanstack/react-query": "5.104.0",
    "axios": "1.20.0",
    "msw": "2.15.0",
    "pixi.js": "8.21.0",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.62.1",
    "@types/node": "22.20.4",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.1",
    "eslint": "10.11.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.5.7",
    "globals": "17.13.0",
    "prettier": "3.9.9",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.0",
    "vite": "8.3.2"
  },
  "msw": {
    "workerDirectory": [
      "public"
    ]
  }
}
